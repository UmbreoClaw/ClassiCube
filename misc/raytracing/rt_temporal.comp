/* Temporal accumulation: reprojects each pixel's hit point into the previous
   frame and blends the noisy lighting terms with the accumulated history when
   the same surface was visible there. */
layout(local_size_x = 8, local_size_y = 8) in;

/* Inputs are read through samplers: drivers only guarantee 8 image units per shader */
layout(binding = 6)  uniform sampler2D gbufCur;
layout(binding = 7)  uniform sampler2D normalCur;
layout(binding = 8)  uniform sampler2D directCur;
layout(binding = 9)  uniform sampler2D indirectCur;
layout(binding = 10) uniform sampler2D gbufPrev;
layout(binding = 11) uniform sampler2D normalPrev;
layout(binding = 12) uniform sampler2D accumDirPrev;
layout(binding = 13) uniform sampler2D accumIndPrev;
layout(rgba16f, binding = 0) uniform writeonly image2D accumDirOut;  /* rgb = direct, w = history length */
layout(rgba16f, binding = 1) uniform writeonly image2D accumIndOut;  /* rgb = indirect, w = history length */

#define MAX_HISTORY 48.0

void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	if (px.x >= screen.x || px.y >= screen.y) return;

	vec4 g   = texelFetch(gbufCur, px, 0);
	vec4 dir = texelFetch(directCur, px, 0);
	vec4 ind = texelFetch(indirectCur, px, 0);
	if (g.w < 0.0) {
		imageStore(accumDirOut, px, vec4(0.0));
		imageStore(accumIndOut, px, vec4(0.0));
		return;
	}

	vec4  nrm = texelFetch(normalCur, px, 0);
	float history = 0.0;
	vec3  prevDir = vec3(0.0), prevInd = vec3(0.0);

	/* Where was this world position on screen last frame? */
	vec4 prevClip = prevViewProj * vec4(g.xyz, 1.0);
	if (prevClip.w > 0.0) {
		vec2 prevNdc = prevClip.xy / prevClip.w;
		ivec2 pp = ivec2(floor((prevNdc * 0.5 + 0.5) * vec2(screen.xy)));

		if (all(greaterThanEqual(pp, ivec2(0))) && all(lessThan(pp, screen.xy))) {
			vec4 pg = texelFetch(gbufPrev, pp, 0);
			vec4 pn = texelFetch(normalPrev, pp, 0);

			bool samePoint  = pg.w > 0.0 && distance(pg.xyz, g.xyz) < 0.02 + 0.004 * g.w;
			bool sameNormal = dot(pn.xyz, nrm.xyz) > 0.9;
			bool sameBlock  = abs(pn.w - nrm.w) < 0.5;

			if (samePoint && sameNormal && sameBlock) {
				vec4 ad = texelFetch(accumDirPrev, pp, 0);
				vec4 ai = texelFetch(accumIndPrev, pp, 0);
				history = ai.w;
				prevDir = ad.rgb;
				prevInd = ai.rgb;
			}
		}
	}

	float dirHistory = min(history + 1.0, MAX_HISTORY);
	vec3  outDir = mix(prevDir, dir.rgb, 1.0 / dirHistory);
	/* Hard shadows are noise free, so don't smear them over time */
	if ((screen.w & FLAG_SOFT_SHADOWS) == 0) outDir = dir.rgb;

	vec3 outInd;
	if (ind.a > 0.5) {
		history = min(history + 1.0, MAX_HISTORY);
		outInd  = mix(prevInd, ind.rgb, 1.0 / history);
	} else {
		/* no GI sample this frame (checkerboard): keep the history as is, */
		/*  history 0 marks a hole for the blur pass to fill from neighbours */
		outInd = prevInd;
	}

	imageStore(accumDirOut, px, vec4(outDir, dirHistory));
	imageStore(accumIndOut, px, vec4(outInd, history));
}
